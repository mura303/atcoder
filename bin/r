#!/usr/bin/env python3
"""コンテスト用バイナリを 1 回だけ実行する。

    bin/r abc430 c               # contests/abc430/c.cpp (または c.rb) を通常実行
    bin/r abc430 c < input.txt    # 標準入力を流し込んで実行

標準入力が端末なら contests/<contest>/tests/<problem>/1.in を流す。
release ビルドでコンパイルして、そのまま実行する。サンプル比較はしない。
"""
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from judgelib import build, pick_lang

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def main():
    argv = sys.argv[1:]
    if len(argv) < 2:
        sys.exit(__doc__)

    lang = None
    if "--lang" in argv:
        i = argv.index("--lang")
        lang = argv[i + 1]
        del argv[i : i + 2]
    contest, problem = argv[0], argv[1]
    default_input = os.path.join(ROOT, "contests", contest, "tests", problem, "1.in")

    lang, src = pick_lang(contest, problem, lang)
    cmd = build(contest, problem, lang, src)
    if sys.stdin.isatty():
        with open(default_input, encoding="utf-8") as f:
            input_text = f.read()
        sys.exit(subprocess.run(cmd, input=input_text, text=True).returncode)

    sys.exit(subprocess.run(cmd).returncode)


if __name__ == "__main__":
    main()